{
    "name": "survos/claims-bundle",
    "description": "Store machine, human, and source assertions as append-only claims with confidence, basis, and provenance.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "claims", "metadata", "confidence", "provenance", "source-data"],
    "autoload": {
        "psr-4": {
            "Survos\\ClaimsBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.5",
        "doctrine/orm": "^3.6",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/dbal": "^3.9||^4.2",
        "survos/data-contracts": "^2.5",
        "survos/field-bundle": "^2.5",
        "survos/jsonl-bundle": "^2.5",
        "symfony/framework-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "api-platform/core": "^4.0 || ^5.0"
    },
    "suggest": {
        "api-platform/core": "Exposes Claim as an ApiResource with schema + concrete examples."
    },
    "extra": {
        "symfony": {
            "require": "^8.0"
        }
    }
}
